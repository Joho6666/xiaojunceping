# AgentScope local config. Copy to .env.local.
# Do not set USE_MOCK_DATA=true unless you are explicitly running UI demos.

DATABASE_ENCRYPTION_KEY=

# Live evaluation is off until you connect Codex CLI or an API key in /settings/ai.
USE_MOCK_DATA=false

AI_FAST_MODEL=
AI_REASONING_MODEL=
AI_RESEARCH_MODEL=
AI_REVIEW_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional semantic retrieval. All three required or retrieval stays lexical.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_REDIRECT_URI=
ANTHROPIC_CLIENT_ID=
ANTHROPIC_CLIENT_SECRET=
ANTHROPIC_REDIRECT_URI=
GEMINI_CLIENT_ID=
GEMINI_CLIENT_SECRET=
GEMINI_REDIRECT_URI=

# Optional. Without it GitHub checks are partially_verified, never verified.
GITHUB_TOKEN=
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=
GEMINI_CLI_PATH=
ANALYSIS_ORCHESTRATOR=local
PROMPT_VERSION=1
